{
  "name": "forge-developer-studio",
  "version": "1.0.0",
  "description": "Forge Developer Studio - IDE desktop para programadores",
  "main": "src/main.js",
  "author": "Forge Studios",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.forgestudios.developerstudio",
    "productName": "Forge Developer Studio",
    "directories": {"output": "dist"},
    "files": ["src/**/*", "package.json"],
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}, {"target": "portable", "arch": ["x64"]}]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true}
  }
}